{
  "name": "dsh-copy-find-in-session",
  "version": "1.0.0",
  "type": "module",
  "description": "Ctrl+F in a DSH session transcript with nearest-first hits, in-place highlight and natively selectable text for Ctrl+C. DSH 会话内 Ctrl+F 查找，命中就近跳转、原位高亮，正文可原生选中复制。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "find-in-page",
    "ctrl-f",
    "search",
    "copy",
    "transcript",
    "session"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiawar/dsh-copy-find-in-session.git"
  },
  "homepage": "https://github.com/aiawar/dsh-copy-find-in-session",
  "bugs": {
    "url": "https://github.com/aiawar/dsh-copy-find-in-session/issues"
  },
  "author": "aiawar",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
